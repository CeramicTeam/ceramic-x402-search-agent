# Demo wallet key. Create one with `npm run wallet:new` instead of pasting a real wallet's key.
PRIVATE_KEY=

# Needed for `npm run agent` only.
ANTHROPIC_API_KEY=

# Spending caps, in USDC. Nothing above these is ever signed.
MAX_USDC_PER_SEARCH=0.01
MAX_USDC_PER_RUN=0.05

# Optional overrides.
SEARCH_URL=https://api.ceramic.ai/search
MODEL=claude-sonnet-5
BASE_RPC_URL=https://mainnet.base.org
